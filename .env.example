# Supply a URL for a dedicated local development PostgreSQL database.
# Example format: postgresql://USER:PASSWORD@127.0.0.1:5432/relay_dev
DATABASE_URL=
# Explicit opt-in for unauthenticated loopback-only read APIs. Never enable in production.
RELAY_DEV_READS=false
# Seed refuses to write unless this is enabled outside production.
RELAY_ALLOW_SEED=false
# Optional override; defaults to the repository's ignored data directory.
# RELAY_DATA_DIR=
