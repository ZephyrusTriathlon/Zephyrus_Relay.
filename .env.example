# REQUIRED for local Node execution. Compose supplies its own internal URL.
DATABASE_URL=postgresql://relay:CHANGE_ME@127.0.0.1:5432/relay
# REQUIRED: generate independently with a password manager or openssl rand -hex 32.
SESSION_SECRET=
# REQUIRED for Compose: random URL-safe alphanumeric password, no URL delimiters.
POSTGRES_PASSWORD=
# OPTIONAL: Compose host port, published on 127.0.0.1 only.
APP_PORT=3001
# Judge bootstrap opt-in; creates records once, never resets passwords/progress.
# Disable after first bootstrap, and for deployments with real accounts.
RELAY_ALLOW_SEED=true
# Local server default; container always sets production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Exact supplied competition references, packaged for fresh installs.
# Compose always uses /app/prisma/judge-data. Never serve these files publicly.
RELAY_DATA_DIR=prisma/judge-data
# Isolated judge deployment: preserve the supplied historical calendar and enable
# new orders using this disclosed business clock. Real operational use: false,
# remove RELAY_JUDGE_ORDER_NOW, and import authorized current calendar coverage.
RELAY_JUDGE_MODE=true
RELAY_JUDGE_ORDER_NOW=2025-01-01T15:00:00+05:30
# PRODUCTION SECURITY: true for HTTPS. false ONLY for local HTTP judge preview.
# If unset, true in production; Compose defaults false on loopback.
SESSION_COOKIE_SECURE=false
# true only behind a trusted single HTTPS-terminating reverse proxy.
TRUST_PROXY=false
# DEVELOPMENT ONLY: loopback authenticated reference reads; forbidden in production.
RELAY_DEV_READS=false
# Build-time settings; production Dockerfile pins dev tools false.
VITE_ENABLE_DEV_TOOLS=false
VITE_API_BASE_URL=/api
# Optional Vite dev proxy (configure in apps/web/.env if changing it).
# API_PROXY_TARGET=http://127.0.0.1:3001
# DEVELOPMENT/TEST ONLY: new-order demo; forbidden in production.
# RELAY_DEMO_ORDER_NOW=2025-01-03T15:59:00+05:30
# Browser QA only, not needed to run the application:
# RELAY_CDP_URL=http://127.0.0.1:9222
# RELAY_URL=http://127.0.0.1:4173
# Explicit fresh-scenario acceptance only: advances seeded operations in a test DB.
# RELAY_JUDGE_TEST=true
